# spike artefacts (throwaway verification code keeps its scripts, not its data)
spikes/**/node_modules/
spikes/**/.venv/
spikes/data/
spikes/**/out_*.png
spikes/**/*_redacted.png
spikes/**/*.traineddata
spikes/redaction/fixtures/*.png

# python / node
__pycache__/
*.pyc
.venv/
node_modules/
.next/
.DS_Store
.vscode/
eval/results/.spend.lock
